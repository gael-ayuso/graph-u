# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
/.impeccable/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build
/dist/

# tool caches
/.cache/
/.turbo/
.eslintcache
.stylelintcache

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.swp
*.swo
*~

# local editor configuration
/.idea/
/.vscode/*.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
/logs/

# local environment files; keep the shared template versioned
.env*
!.env.example

# generated Prisma client
/lib/generated/prisma/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify
/graphify-out/
